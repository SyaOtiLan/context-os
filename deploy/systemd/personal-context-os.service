[Unit]
Description=Personal Context OS API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/personal-context-os
Environment=PCOS_DB_PATH=/opt/personal-context-os/data/app.db
EnvironmentFile=-/etc/personal-context-os.env
ExecStart=/opt/personal-context-os/.venv/bin/uvicorn personal_agent.main:app --host 0.0.0.0 --port 5000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
