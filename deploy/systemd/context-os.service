[Unit]
Description=ContextOS API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/context-os
Environment=PCOS_DB_PATH=/opt/context-os/data/app.db
EnvironmentFile=-/etc/context-os.env
ExecStart=/opt/context-os/.venv/bin/uvicorn personal_agent.main:app --host 0.0.0.0 --port 5000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
