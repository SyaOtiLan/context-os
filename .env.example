PCOS_DB_PATH=data/app.db

PCOS_LLM_API_BASE=https://api.hanbbq.top/v1
PCOS_LLM_API_KEY=replace-with-your-key
PCOS_LLM_MODEL=gpt-5.4
PCOS_LLM_WIRE_API=responses
PCOS_LLM_REASONING_EFFORT=xhigh
PCOS_LLM_DISABLE_RESPONSE_STORAGE=true
PCOS_LLM_TIMEOUT_SECONDS=60

# Optional GitHub API token for higher rate limits.
PCOS_GITHUB_TOKEN=

# Optional SMTP output for notification_outbox email delivery.
PCOS_SMTP_HOST=smtp.example.com
PCOS_SMTP_PORT=587
PCOS_SMTP_USERNAME=
PCOS_SMTP_PASSWORD=
PCOS_SMTP_FROM=contextos@example.com
PCOS_SMTP_TO=you@example.com
PCOS_SMTP_USE_TLS=true
